{
	"name": "oja-talu",
	"version": "0.1.0",
	"private": true,
	"description": "Build tooling for the Oja Talu WordPress block theme's custom Gutenberg blocks.",
	"scripts": {
		"build": "cross-env NODE_ENV=production webpack --config webpack.config.js",
		"start": "cross-env NODE_ENV=development webpack --config webpack.config.js --watch",
		"lint:js": "wp-scripts lint-js blocks/src",
		"lint:css": "wp-scripts lint-style blocks/src",
		"format": "wp-scripts format blocks/src"
	},
	"devDependencies": {
		"@babel/core": "^7.24.0",
		"@wordpress/babel-preset-default": "^7.39.0",
		"@wordpress/scripts": "^30.0.0",
		"babel-loader": "^9.1.3",
		"copy-webpack-plugin": "^12.0.2",
		"cross-env": "^7.0.3",
		"css-loader": "^6.10.0",
		"mini-css-extract-plugin": "^2.8.1",
		"sass": "^1.75.0",
		"sass-loader": "^14.1.1",
		"webpack": "^5.91.0",
		"webpack-cli": "^5.1.4"
	}
}
